<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.1.1</Version>
    <Authors>Mr.MingOuyang</Authors>
    <Description>Lightweight SQLite logging and embedded dashboard for ASP.NET Core.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.22" />
    <EmbeddedResource Include="Dashboard/index.html" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
