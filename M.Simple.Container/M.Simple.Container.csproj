<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0.3</Version>
    <PackageReleaseNotes>Add parameterless InterceptedScoped, InterceptedTransient and InterceptedSingleton assembly scanning through optional runtime adaptation to M.Simple.Services.Interception, without a package dependency.</PackageReleaseNotes>
    <Authors>Mr.Sunny</Authors>
    <Description>A lightweight .NET dependency injection container with assembly scanning and standard hosting integration.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
