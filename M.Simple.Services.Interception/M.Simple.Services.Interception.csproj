<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0.8</Version>
    <PackageReleaseNotes>Publish the per-method ContinueOnFailure and RunOnBusinessFailure options without transactional execution changes.</PackageReleaseNotes>
    <Authors>Mr.Sunny</Authors>
    <Description>Interface method interception with synchronous and asynchronous hooks for .NET 8.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
